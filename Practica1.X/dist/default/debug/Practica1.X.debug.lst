   309                           ;Config register CONFIG1 @ 0x2007
   310                           ;	Oscillator Selection bits
   311                           ;	FOSC = XT, XT oscillator: Crystal/resonator on RA6/OSC2/CLKOUT and RA7/OSC1/CLKIN
   312                           ;	Watchdog Timer Enable bit
   313                           ;	WDTE = OFF, WDT disabled and can be enabled by SWDTEN bit of the WDTCON register
   314                           ;	Power-up Timer Enable bit
   315                           ;	PWRTE = OFF, PWRT disabled
   316                           ;	RE3/MCLR pin function select bit
   317                           ;	MCLRE = 0x1, unprogrammed default
   318                           ;	Code Protection bit
   319                           ;	CP = OFF, Program memory code protection is disabled
   320                           ;	Data Code Protection bit
   321                           ;	CPD = OFF, Data memory code protection is disabled
   322                           ;	Brown Out Reset Selection bits
   323                           ;	BOREN = ON, BOR enabled
   324                           ;	Internal External Switchover bit
   325                           ;	IESO = 0x1, unprogrammed default
   326                           ;	Fail-Safe Clock Monitor Enabled bit
   327                           ;	FCMEN = 0x1, unprogrammed default
   328                           ;	Low Voltage Programming Enable bit
